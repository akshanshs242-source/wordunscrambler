---
// Footer.astro - Minimal, high-trust developer-grade footer
---

<footer class="mt-auto border-t border-[var(--hairline)] bg-[var(--canvas)] py-12 text-[var(--body)] transition-colors duration-200">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Col 1: Brand -->
      <div>
        <div class="flex items-center gap-2">
          <div class="flex h-7 w-7 items-center justify-center rounded-md bg-gradient-to-br from-[var(--accent-blue)] to-[var(--accent-violet)] text-white">
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
              <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" />
              <polyline points="13 2 13 9 20 9" />
            </svg>
          </div>
          <span class="text-sm font-bold tracking-tight text-[var(--ink)]">Word Unscrambler</span>
        </div>
        <p class="mt-3 text-xs leading-relaxed text-[var(--mute)]">
          A free, fast word unscrambler tool with multiple dictionaries, wildcard support, and definitions. Perfect for Scrabble, Wordle, and word games.
        </p>
        <div class="mt-4 flex items-center gap-2 font-mono text-[11px] text-[var(--mute)]">
          <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
          <span>Lightning-Fast Results</span>
        </div>
      </div>

      <!-- Col 2: Dictionaries & Games -->
      <div>
        <h4 class="font-mono text-xs font-semibold tracking-wider text-[var(--ink)] uppercase">
          Supported Games
        </h4>
        <ul class="mt-3 space-y-2 text-xs">
          <li><a href="#games" class="hover:text-[var(--ink)]">Scrabble Solver</a></li>
          <li><a href="#games" class="hover:text-[var(--ink)]">Wordle Helper</a></li>
          <li><a href="#games" class="hover:text-[var(--ink)]">Words with Friends</a></li>
          <li><a href="#games" class="hover:text-[var(--ink)]">Wordscapes Solver</a></li>
          <li><a href="#games" class="hover:text-[var(--ink)]">Spelling Bee Finder</a></li>
        </ul>
      </div>

      <!-- Col 3: Features -->
      <div>
        <h4 class="font-mono text-xs font-semibold tracking-wider text-[var(--ink)] uppercase">
          Features
        </h4>
        <ul class="mt-3 space-y-2 text-xs">
          <li><a href="#features" class="hover:text-[var(--ink)]">Multiple Dictionaries</a></li>
          <li><a href="#features" class="hover:text-[var(--ink)]">Wildcard Support</a></li>
          <li><a href="#features" class="hover:text-[var(--ink)]">Advanced Filtering</a></li>
          <li><a href="#features" class="hover:text-[var(--ink)]">Word Definitions</a></li>
          <li><a href="#features" class="hover:text-[var(--ink)]">Frequency Scores</a></li>
        </ul>
      </div>

      <!-- Col 4: Trust & Legal -->
      <div>
        <h4 class="font-mono text-xs font-semibold tracking-wider text-[var(--ink)] uppercase">
          Legal & Privacy
        </h4>
        <ul class="mt-3 space-y-2 text-xs">
          <li><span class="text-[var(--mute)]">Zero Logs Kept</span></li>
          <li><span class="text-[var(--mute)]">100% Free Forever</span></li>
          <li><span class="text-[var(--mute)]">No Registration Needed</span></li>
          <li><span class="text-[var(--mute)]">Mobile Responsive</span></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Disclaimer & Copyright -->
    <div class="mt-12 border-t border-[var(--hairline)] pt-6 text-center text-[11px] text-[var(--mute)]">
      <p>
        Word Unscrambler is an independent word game utility tool. It is not affiliated with, endorsed by, or sponsored by Hasbro (Scrabble), The New York Times (Wordle), Zynga (Words with Friends), or any other game company. All product names, logos, and brands are property of their respective owners.
      </p>
      <p class="mt-2">
        © {new Date().getFullYear()} Word Unscrambler • All rights reserved • Designed with Geist System.
      </p>
    </div>
  </div>
</footer>
