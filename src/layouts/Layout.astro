---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
}

const {
  title = "Word Unscrambler - Find Words from Letters | Free Online Tool",
  description = "Unscramble letters to find valid words instantly. Free word unscrambler tool with multiple dictionaries (ENABLE, TWL, CSW), wildcard support, definitions, and word frequency data. Perfect for Scrabble, Wordle, and word games.",
  canonical = "https://wordunscramblar.com/",
  image = "https://wordunscramblar.com/og-image.png",
} = Astro.props;

// Schema.org structured data for WebApplication & SoftwareApplication
const schemaWebapp = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Word Unscrambler",
  "url": "https://wordunscramblar.com/",
  "applicationCategory": "UtilityApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": description,
  "featureList": [
    "Unscramble letters to find valid words",
    "Multiple dictionary support (ENABLE, TWL, CSW)",
    "Wildcard character support (? and *)",
    "Advanced filtering (starts with, ends with, must include)",
    "Word definitions and frequency data",
    "Results organized by word length",
    "Support for Scrabble, Wordle, and word games",
    "Fast instant results under 200ms",
    "Dark and light mode support",
    "Mobile-responsive design"
  ]
};

const schemaFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is a word unscrambler?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A word unscrambler is a tool that takes scrambled or jumbled letters and finds all valid words that can be made from those letters. It's useful for word games like Scrabble, Wordle, and Words with Friends."
      }
    },
    {
      "@type": "Question",
      "name": "How many letters can I unscramble?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can unscramble up to 15 letters. Simply enter your letters and the tool will instantly find all valid words that can be formed."
      }
    },
    {
      "@type": "Question",
      "name": "What does the wildcard (?) character do?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The wildcard character (? or *) acts as a placeholder for any single letter. For example, if you enter 'c?t', it will find words like 'cat', 'cot', 'cut', and 'cut'."
      }
    },
    {
      "@type": "Question",
      "name": "Which dictionaries are supported?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We support three dictionaries: ENABLE (standard English), TWL (North American tournament play), and CSW (international/Collins)."
      }
    },
    {
      "@type": "Question",
      "name": "Can I filter results by word pattern?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! Use advanced filters to narrow results: 'Starts with' (e.g., words starting with 'st'), 'Ends with' (e.g., words ending with 'ing'), and 'Must include' (e.g., must contain 'qu')."
      }
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-4CSMNR1GQ1"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-4CSMNR1GQ1');
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="word unscram" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:site_name" content="Word Unscrambler" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:site" content="@wordunscramblar" />
    <meta name="twitter:creator" content="@wordunscramblar" />

    <!-- Additional SEO Meta Tags -->
    <meta name="theme-color" content="#00dfd8" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Word Unscrambler" />

    <!-- SEO & Performance Fonts (Geist & Geist Mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Geist:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaWebapp)} />
    <script type="application/ld+json" set:html={JSON.stringify(schemaFaq)} />

    <!-- Anti-FOUC Theme Initializer -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="relative min-h-screen selection:bg-[#00dfd8]/30 selection:text-current">
    <div class="mesh-gradient-bg" aria-hidden="true"></div>
    <div class="relative z-10 flex min-h-screen flex-col">
      <slot />
    </div>
  </body>
</html>
