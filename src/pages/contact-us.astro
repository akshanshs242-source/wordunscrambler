---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Contact Us - Word Unscrambler"
  description="Get in touch with Word Unscrambler. We'd love to hear from you."
  canonical="https://wordunscramblar.com/contact-us"
>
  <Navbar />
  <main class="flex-1">
    <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 sm:py-24">
      <!-- Header -->
      <div class="mb-16 text-center">
        <h1 class="text-4xl font-bold tracking-tight text-[var(--ink)] sm:text-5xl">
          Get in Touch
        </h1>
        <p class="mt-4 text-lg text-[var(--body)]">
          Have a question or feedback? We'd love to hear from you.
        </p>
      </div>

      <!-- Content Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 mb-16">
        <!-- Contact Info Cards -->
        <div class="lg:col-span-1">
          <div class="space-y-6">
            <!-- Email -->
            <div class="rounded-lg border border-[var(--hairline)] bg-[var(--canvas-elevated)] p-6">
              <div class="flex items-center gap-3 mb-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-[var(--accent-blue)]/20">
                  <svg class="w-5 h-5 text-[var(--accent-blue)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <h3 class="font-semibold text-[var(--ink)]">Email</h3>
              </div>
              <p class="text-sm text-[var(--body)] mb-2">General inquiries and support</p>
              <a href="mailto:hello@wordunscramblar.com" class="text-[var(--accent-blue)] font-mono text-sm hover:underline">
                hello@wordunscramblar.com
              </a>
            </div>

            <!-- Response Time -->
            <div class="rounded-lg border border-[var(--hairline)] bg-[var(--canvas-elevated)] p-6">
              <div class="flex items-center gap-3 mb-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/20">
                  <svg class="w-5 h-5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v3.586L7.707 9.293a1 1 0 00-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L11 10.586V7z" clip-rule="evenodd" />
                  </svg>
                </div>
                <h3 class="font-semibold text-[var(--ink)]">Response Time</h3>
              </div>
              <p class="text-sm text-[var(--body)]">We typically respond within 24-48 hours</p>
            </div>

            <!-- Feedback -->
            <div class="rounded-lg border border-[var(--hairline)] bg-[var(--canvas-elevated)] p-6">
              <div class="flex items-center gap-3 mb-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-[var(--accent-violet)]/20">
                  <svg class="w-5 h-5 text-[var(--accent-violet)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
                  </svg>
                </div>
                <h3 class="font-semibold text-[var(--ink)]">We Value Your Input</h3>
              </div>
              <p class="text-sm text-[var(--body)]">Suggestions and feedback help us improve</p>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="lg:col-span-2">
          <form class="space-y-6 rounded-lg border border-[var(--hairline)] bg-[var(--canvas-elevated)] p-8">
            <!-- Name -->
            <div>
              <label for="name" class="block text-sm font-semibold text-[var(--ink)] mb-2">
                Full Name
              </label>
              <input
                type="text"
                id="name"
                name="name"
                placeholder="Your name"
                class="w-full rounded-lg border border-[var(--hairline)] bg-[var(--canvas)] px-4 py-2.5 text-[var(--body)] placeholder-[var(--mute)] transition-colors focus:border-[var(--accent-blue)] focus:outline-none focus:ring-2 focus:ring-[var(--accent-blue)]/20"
              />
            </div>

            <!-- Email -->
            <div>
              <label for="email" class="block text-sm font-semibold text-[var(--ink)] mb-2">
                Email Address
              </label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="your.email@example.com"
                class="w-full rounded-lg border border-[var(--hairline)] bg-[var(--canvas)] px-4 py-2.5 text-[var(--body)] placeholder-[var(--mute)] transition-colors focus:border-[var(--accent-blue)] focus:outline-none focus:ring-2 focus:ring-[var(--accent-blue)]/20"
              />
            </div>

            <!-- Subject -->
            <div>
              <label for="subject" class="block text-sm font-semibold text-[var(--ink)] mb-2">
                Subject
              </label>
              <select
                id="subject"
                name="subject"
                class="w-full rounded-lg border border-[var(--hairline)] bg-[var(--canvas)] px-4 py-2.5 text-[var(--body)] transition-colors focus:border-[var(--accent-blue)] focus:outline-none focus:ring-2 focus:ring-[var(--accent-blue)]/20"
              >
                <option value="">Select a subject</option>
                <option value="support">Technical Support</option>
                <option value="feature">Feature Request</option>
                <option value="bug">Bug Report</option>
                <option value="feedback">General Feedback</option>
                <option value="other">Other</option>
              </select>
            </div>

            <!-- Message -->
            <div>
              <label for="message" class="block text-sm font-semibold text-[var(--ink)] mb-2">
                Message
              </label>
              <textarea
                id="message"
                name="message"
                rows="5"
                placeholder="Please share your thoughts, questions, or feedback..."
                class="w-full rounded-lg border border-[var(--hairline)] bg-[var(--canvas)] px-4 py-2.5 text-[var(--body)] placeholder-[var(--mute)] transition-colors focus:border-[var(--accent-blue)] focus:outline-none focus:ring-2 focus:ring-[var(--accent-blue)]/20 resize-none"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <div class="flex gap-3">
              <button
                type="submit"
                class="flex-1 rounded-lg bg-[var(--primary)] px-6 py-2.5 font-semibold text-[var(--on-primary)] transition-transform hover:scale-105 focus:outline-none focus:ring-2 focus:ring-[var(--accent-blue)]/20"
              >
                Send Message
              </button>
              <button
                type="reset"
                class="flex-1 rounded-lg border border-[var(--hairline)] px-6 py-2.5 font-semibold text-[var(--body)] transition-colors hover:border-[var(--mute)] focus:outline-none focus:ring-2 focus:ring-[var(--accent-blue)]/20"
              >
                Clear
              </button>
            </div>

            <p class="text-xs text-[var(--mute)] text-center">
              We respect your privacy. Your information will only be used to respond to your inquiry.
            </p>
          </form>
        </div>
      </div>

      <!-- FAQ Section -->
      <section class="rounded-lg border border-[var(--hairline)] bg-[var(--canvas-elevated)] p-8">
        <h2 class="text-2xl font-bold text-[var(--ink)] mb-6">Frequently Asked Questions</h2>

        <div class="space-y-4">
          <details class="group border-b border-[var(--hairline)] pb-4 last:border-b-0">
            <summary class="flex cursor-pointer items-center justify-between font-semibold text-[var(--ink)] hover:text-[var(--accent-blue)]">
              Is Word Unscrambler really free?
              <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </summary>
            <p class="mt-3 text-[var(--body)]">Yes, completely! There are no hidden fees, premium features, or paywalls. Word Unscrambler is free forever.</p>
          </details>

          <details class="group border-b border-[var(--hairline)] pb-4 last:border-b-0">
            <summary class="flex cursor-pointer items-center justify-between font-semibold text-[var(--ink)] hover:text-[var(--accent-blue)]">
              Do you collect my search data?
              <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </summary>
            <p class="mt-3 text-[var(--body)]">No. We don't track or store your searches. Your privacy is completely protected. See our Privacy Policy for details.</p>
          </details>

          <details class="group border-b border-[var(--hairline)] pb-4 last:border-b-0">
            <summary class="flex cursor-pointer items-center justify-between font-semibold text-[var(--ink)] hover:text-[var(--accent-blue)]">
              What dictionaries do you support?
              <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </summary>
            <p class="mt-3 text-[var(--body)]">We support ENABLE, TWL, and CSW dictionaries. This covers Scrabble, Wordle, Words with Friends, and other popular word games.</p>
          </details>

          <details class="group border-b border-[var(--hairline)] pb-4 last:border-b-0">
            <summary class="flex cursor-pointer items-center justify-between font-semibold text-[var(--ink)] hover:text-[var(--accent-blue)]">
              How fast are the results?
              <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </summary>
            <p class="mt-3 text-[var(--body)]">Results are typically returned in under 200ms, making Word Unscrambler one of the fastest tools available.</p>
          </details>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  // Form submission handler (basic client-side validation)
  document.querySelector('form')?.addEventListener('submit', (e) => {
    e.preventDefault();

    const form = e.target;
    const name = form.querySelector('#name')?.value;
    const email = form.querySelector('#email')?.value;
    const message = form.querySelector('#message')?.value;

    if (!name || !email || !message) {
      alert('Please fill out all required fields.');
      return;
    }

    // In a real implementation, you would send this to a backend service
    console.log('Form submitted:', { name, email, message });
    alert('Thank you for your message! We\'ll get back to you soon.');
    form.reset();
  });
</script>
